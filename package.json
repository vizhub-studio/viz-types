{
  "name": "@vizhub/viz-types",
  "version": "0.5.0",
  "description": "Shared TypeScript types for the VizHub ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prettier": "npm run format",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "tsc --noEmit -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizhub-studio/viz-types.git"
  },
  "author": "Curran Kelleher",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vizhub-studio/viz-types/issues"
  },
  "homepage": "https://github.com/vizhub-studio/viz-types#readme",
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
